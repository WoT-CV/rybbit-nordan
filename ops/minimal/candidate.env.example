# Preparation only. Do not use production secrets, volumes, or the production project.
# Real image digests/source publication are mandatory before starting a candidate.
# CLIENT IMAGE BUILD: NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:13001 (NO /api),
# NEXT_PUBLIC_CLOUD=false. Runtime env cannot repoint Next.js compiled chunks.
# BASE_URL below is the FRONTEND auth origin, NOT the client API build argument.
# Require reviewed source SHA + build provenance + browser network verification.
WOTCV_BACKEND_IMAGE=ghcr.io/example/rybbit-backend@sha256:REPLACE_WITH_APPROVED_DIGEST
WOTCV_CLIENT_IMAGE=ghcr.io/example/rybbit-client@sha256:REPLACE_WITH_APPROVED_DIGEST
SOURCE_CODE_URL=https://github.com/WoT-CV/rybbit-wotcv/tree/REPLACE_WITH_PUBLISHED_COMMIT
DOMAIN_NAME=localhost
BASE_URL=http://127.0.0.1:13002
WOTCV_CANDIDATE_API_URL=http://127.0.0.1:13001
BETTER_AUTH_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET
POSTGRES_DB=analytics
POSTGRES_USER=frog
POSTGRES_PASSWORD=REPLACE_WITH_A_NEW_RANDOM_PASSWORD
CLICKHOUSE_DB=analytics
CLICKHOUSE_PASSWORD=REPLACE_WITH_A_NEW_RANDOM_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_A_NEW_RANDOM_PASSWORD
DISABLE_SIGNUP=true
DISABLE_TELEMETRY=true
MAPBOX_TOKEN=
CLUSTER_WORKERS=0
DEPLOYMENT=
LITE_DASHBOARD=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
WOTCV_REPLAY_CORRELATION_JSON=[]
# Leave empty. Starting the native entrypoint runs migrations/CH initialization.
# An operator decision for EMPTY ISOLATED candidate storage is a separate step.
WOTCV_CANDIDATE_START_ACK=
