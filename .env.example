# Domain and URL Configuration
DOMAIN_NAME=demo.rybbit.com
BASE_URL="https://${DOMAIN_NAME}"

# Authentication and Security
BETTER_AUTH_SECRET=insecure-secret
DISABLE_SIGNUP=false
# Anonymous 24-hour dashboards + expiry cleanup: opt-in on self-hosted.
ENABLE_UNCLAIMED_SITES=false

# Webserver Configuration
# Set to false to disable the built-in Caddy webserver
USE_WEBSERVER=true
# Host port mappings - these control how services are exposed
# WoT-CV requires loopback: host_ip:published_port:container_port
HOST_BACKEND_PORT=127.0.0.1:3001:3001
HOST_CLIENT_PORT=127.0.0.1:3002:3002

# WoT-CV deployment safety. These names bind deployments to the existing
# production Compose project and external data volumes. Do not change them
# unless the migration to new volume names has been planned and verified.
WOTCV_COMPOSE_PROJECT_NAME=rybbit
WOTCV_EXPECTED_COMPOSE_PROJECT_NAME=rybbit
WOTCV_CLICKHOUSE_VOLUME_NAME=rybbit_clickhouse-data
WOTCV_POSTGRES_VOLUME_NAME=rybbit_postgres-data
WOTCV_REDIS_VOLUME_NAME=rybbit_redis-data

# ClickHouse Database Configuration
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=frog
# Optional dedicated password for the least-privilege custom SQL user.
# When unset, Compose uses CLICKHOUSE_PASSWORD. Do not reuse the main username.
# CLICKHOUSE_QUERY_PASSWORD=

POSTGRES_DB=analytics
POSTGRES_USER=frog
POSTGRES_PASSWORD=frog

# Resolve anonymous browser IDs to identified accounts through a ClickHouse
# dictionary backed by PostgreSQL. Set false only for emergency rollback.
IDENTITY_RESOLUTION_V2=true
# Replay metadata rollout: v1 is the safe default. Use dual only after the
# documented one-time v2 backfill and verification; use v2 after rollback closes.
REPLAY_METADATA_MODE=v1

# Authenticated, site-scoped Grafana links. Empty/unset uses the built-in WoT-CV
# production profile for site 2 and https://api.wot-cv.com only.
# Set [] to disable; a JSON array of profiles replaces all built-in defaults.
WOTCV_REPLAY_OBSERVABILITY_PROFILES=
# Merge a recent anonymous recording into the identified session after login.
# Set to 0 for an emergency rollback; values above 120000 are capped.
SESSION_IDENTITY_CONTINUATION_GRACE_MS=30000

# External Service Tokens (optional)
# Public browser token for WoT-CV maps. Override for your deployment; restrict allowed URLs in Mapbox.
MAPBOX_TOKEN=pk.eyJ1Ijoid290LWN2IiwiYSI6ImNtcjZ3OGtyMDBsZWsyenM5aWliNmEyYW8ifQ.UlyVi6ufRJ4dmIfBzbpHHw

# Google OAuth (optional)
# Enables Google login and Google Search Console when both credentials are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# GitHub OAuth login (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare Turnstile protection for authentication forms (optional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Transactional email through Resend (optional)
# EMAIL_FROM is required on self-hosted deployments and must use a verified sender domain.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Weekly reports remain opt-in on self-hosted deployments.
ENABLE_WEEKLY_REPORTS=false

# Cloudflare R2 replay storage (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=rybbit

# Twilio SMS notifications for uptime monitoring (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional replay upload canary; enable only after decoder/proxy/browser validation.
WOTCV_REPLAY_UPLOAD_GZIP=false
